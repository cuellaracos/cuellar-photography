---
import { getPhoto } from '../content/catalog';
import type { Gallery } from '../types/content';

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const cover = getPhoto(gallery.coverPhotoSlug);
if (!cover) throw new Error(`Missing cover photo for gallery ${gallery.slug}`);
---

<a class="gallery-card" href={`/galerias/${gallery.slug}`}>
  <img src={cover.thumbnail} alt={cover.alt} width={cover.width} height={cover.height} loading="lazy" decoding="async" />
  <span class="gallery-card__content"><span>Galería</span><strong>{gallery.title}</strong></span>
</a>