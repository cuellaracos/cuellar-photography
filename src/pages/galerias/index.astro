---
import GalleryGrid from '../../components/GalleryGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories, galleries } from '../../content/catalog';
---

<BaseLayout title="Galerías | Cuellar Photography" description="Galerías de fotografía de José Cuéllar.">
  <section class="page-heading wrap">
    <p class="eyebrow">Archivo</p>
    <h1>Galerías</h1>
    <p>El archivo irá creciendo con nuevas series y categorías.</p>
  </section>
  <section class="wrap gallery-section" aria-label="Categorías fotográficas">
    <p class="category-list">{categories.join(' · ')}</p>
    <GalleryGrid galleries={galleries} />
  </section>
</BaseLayout>