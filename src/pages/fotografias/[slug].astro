---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGallery, getImageSource, photos } from '../../content/catalog';

export function getStaticPaths() {
  return photos.map((photo) => ({ params: { slug: photo.slug }, props: { photo } }));
}

const { photo } = Astro.props;
const gallery = getGallery(photo.gallerySlug);
if (!gallery) throw new Error(`Missing gallery for photo ${photo.slug}`);
---

<BaseLayout title={`${photo.title} | Cuellar Photography`} description={`${photo.title}, fotografía de José Cuéllar.`} image={getImageSource(photo, 'detail')}>
  <article class="photo-detail wrap">
    <div class="photo-detail__image">
      <img src={getImageSource(photo, 'detail')} alt={photo.alt} width={photo.width} height={photo.height} fetchpriority="high" decoding="async" />
    </div>
    <header class="photo-detail__header">
      <a class="back-link" href={`/galerias/${gallery.slug}`}>Volver a la galería</a>
      <p class="eyebrow">{photo.category}</p>
      <h1>{photo.title}</h1>
      <p>Imagen provisional. La obra final sustituirá este placeholder en el catálogo.</p>
    </header>
  </article>
</BaseLayout>