---
import PhotoCard from '../components/PhotoCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { photos } from '../content/catalog';
---

<BaseLayout title="Cuellar Photography | José Cuéllar" description="Fotografía de paisaje, naturaleza, fauna y noche de José Cuéllar.">
  <section class="hero wrap">
    <img class="hero__image" src="/images/Astrofotografia/eclipse-total.jpg" alt={photos[0].alt} width={4096} height={2304} fetchpriority="high" decoding="async" />
    <div class="hero__content">
      <p class="eyebrow">José Cuéllar</p>
      <h1>Fotografía</h1>
      <p>Paisaje · Naturaleza · Fauna · Fotografía nocturna · Astrofotografía</p>
      <a class="button-link" href="/galerias">Ver galerías</a>
    </div>
  </section>
  <section class="wrap featured" aria-labelledby="featured-title">
    <div class="section-heading"><p class="eyebrow">Selección</p><h2 id="featured-title">Obra reciente</h2></div>
    <div class="photo-grid photo-grid--featured">
      {photos.slice(0, 4).map((photo, index) => <PhotoCard photo={photo} priority={index === 0} />)}
    </div>
  </section>
</BaseLayout>